# Godot
.godot/
.import/
*.translation
mono_crash.*.json
export_credentials.cfg

# Heruntergeladene Fremdbestände (per tools/fetch_polyhaven.ps1 wiederherstellbar)
/assets/external/
# Higgsfield-Originale (Laubatlas liegt als assets/style_c/leaf_atlas.png im Repository)
/assets/style_c/source/
/assets/target/source/*
!/assets/target/source/generated.json
# Kartentexturen: Higgsfield-Originale und Vorschauen nicht im Repository, nur das Protokoll
/assets/map/source/*
!/assets/map/source/generated.json
!/assets/map/source/erosion_lauf_*.json

# Erzeugte Programme
/build/
/export/

# Spielstände, Kampagnen, Sicherungen, Schlüssel – nie einchecken
/docs/nachweis/welt.json
/docs/nachweis/*_ansicht.json
/docs/abnahme/*.json
/docs/orte/welt.json
# Ortsprüfung: Einzelbilder stecken in den Bögen (vergleich_*.jpg, bearbeitung_<stelle>.jpg)
/docs/orte/ort_*.jpg
/docs/orte/bearbeitung_gipfel_*.jpg
/docs/orte/bearbeitung_tal_*.jpg
/docs/orte/bearbeitung_pass_vorher.jpg
/docs/orte/bearbeitung_pass_nachher.jpg
*_ansicht.json
*.defekt
*.json.neu
/saves/
/campaigns/
/backups/
/Sicherungen/
*.bak
*.backup
*.key
*.pem
*.p12
*.keystore
.env
.env.*

# System
.DS_Store
Thumbs.db
desktop.ini

# Lokale Claude-Einstellungen
.claude/settings.local.json

# Arbeitskopien paralleler Agenten
/.claude/worktrees/

# Filmaufnahme (groß, wird neu erzeugt: --write-movie … -- --aufnahme=<Ordner>)
/docs/aufnahme/*.ogv
# Echtzeit-Aufnahme (--echtzeit=<Ordner>, tools/make_video.py): Einzelbilder und Film neu erzeugbar
/docs/aufnahme/*.avi
/docs/aufnahme/**/frames/
/docs/aufnahme/**/*.avi
/docs/aufnahme/**/welt.json

# Daten der Detailregionen (gehören zur Weltdatei, nie einchecken)
*_regionen/

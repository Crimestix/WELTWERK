[gd_scene format=3]

[ext_resource type="Script" path="res://src/main.gd" id="1_main"]
[ext_resource type="Script" path="res://src/world/terrain.gd" id="2_terrain"]
[ext_resource type="Script" path="res://src/camera/strategy_camera.gd" id="3_camera"]
[ext_resource type="Script" path="res://src/ui/controls_help.gd" id="4_help"]
[ext_resource type="PackedScene" path="res://scenes/lighting.tscn" id="5_lighting"]

[node name="Main" type="Node3D"]
script = ExtResource("1_main")

[node name="Lighting" parent="." instance=ExtResource("5_lighting")]

[node name="Terrain" type="Node3D" parent="."]
script = ExtResource("2_terrain")

[node name="CameraRig" type="Node3D" parent="." node_paths=PackedStringArray("terrain", "sun")]
script = ExtResource("3_camera")
terrain = NodePath("../Terrain")
sun = NodePath("../Lighting/Sun")

[node name="Camera3D" type="Camera3D" parent="CameraRig"]
current = true
fov = 50.0

[node name="Interface" type="CanvasLayer" parent="."]

[node name="ControlsHelp" type="PanelContainer" parent="Interface"]
anchors_preset = 2
anchor_top = 1.0
anchor_bottom = 1.0
offset_left = 16.0
offset_top = -16.0
offset_right = 16.0
offset_bottom = -16.0
grow_vertical = 0
script = ExtResource("4_help")
